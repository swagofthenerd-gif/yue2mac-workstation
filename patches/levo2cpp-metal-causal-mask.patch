 #include <utility>
 #include <vector>
 
+// Metal in this ggml has no DIAG_MASK_INF, so causal masks are built from ops every
+// backend supports and passed to soft_max_ext. Masked scores get -1e30 (exp -> 0).
+static ggml_tensor * levo_causal_mask(ggml_context * context, ggml_tensor * scores, int64_t past) {
+    const int64_t keys = scores->ne[0];
+    const int64_t queries = scores->ne[1];
+    ggml_tensor * cols = ggml_reshape_2d(context, ggml_arange(context, 0.0F, static_cast<float>(keys), 1.0F), keys, 1);
+    ggml_tensor * rows = ggml_reshape_2d(context,
+        ggml_arange(context, static_cast<float>(past), static_cast<float>(past + queries), 1.0F), 1, queries);
+    ggml_tensor * shape = ggml_view_2d(context, scores, keys, queries, scores->nb[1], 0);
+    ggml_tensor * diff = ggml_sub(context, ggml_repeat(context, cols, shape), rows);  // key - (past + query)
+    ggml_tensor * future = ggml_step(context, ggml_scale_bias(context, diff, 1.0F, -0.5F));
+    return ggml_scale(context, future, -1.0e30F);
+}
